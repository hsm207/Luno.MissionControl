    <script src="@Assets["_content/Microsoft.FluentUI.AspNetCore.Components/Microsoft.FluentUI.AspNetCore.Components.lib.module.js"]" type="module"></script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
