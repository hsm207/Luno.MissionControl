@using Microsoft.FluentUI.AspNetCore.Components
@using Luno.MissionControl.Web.Client
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["Luno.MissionControl.Web.styles.css"]" />
    <link rel="stylesheet" href="@Assets["Luno.MissionControl.Web.Client.bundle.scp.css"]" />
    <ImportMap />
