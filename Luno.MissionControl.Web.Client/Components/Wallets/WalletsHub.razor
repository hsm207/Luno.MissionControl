@page "/wallets"
@rendermode InteractiveAuto
@namespace Luno.MissionControl.Web.Client.Components.Wallets
@using Microsoft.FluentUI.AspNetCore.Components

<div class="wallets-container">
    <FluentStack VerticalAlignment="VerticalAlignment.Center" Style="margin-bottom: 2rem;">
        <FluentIcon Value="@(new Icons.Regular.Size32.Wallet())" Color="Color.Primary" />
        <FluentText Typo="Typography.H2">Wallets Hub</FluentText>
    </FluentStack>

    @if (_isLoading)
    {
        <FluentSpinner />
    }
    else if (_errorMessage != null)
    {
        <FluentMessageBar Title="Error" Intent="MessageBarIntent.Error">
            @_errorMessage
        </FluentMessageBar>
    }
    else if (_overview != null)
    {
        <FluentGrid Spacing="3" AdaptiveSize="GridItemSize.Xs">
            @foreach (var item in _overview)
            {
                <FluentGridItem Xs="12" Sm="6" Md="4">
                    <FluentCard Class="wallet-card">
                        
                        @if (item.IsAmbiguous)
                        {
                            <FluentBadge Id="@($"ambiguous-badge-{item.Asset}")" 
                                         Color="BadgeColor.Danger" 
                                         Class="ambiguous-badge">
                                AMBIGUOUS
                            </FluentBadge>
                        }

                        <FluentStack Orientation="Orientation.Vertical" VerticalGap="5">
                            <FluentText Typo="Typography.H3">@item.Asset</FluentText>
                            <FluentText Typo="Typography.Body">Available Accounts: @item.Accounts.Count</FluentText>
                        </FluentStack>

                        <FluentDivider />

                        <FluentStack Orientation="Orientation.Vertical" VerticalGap="10" Class="account-list">
                            @foreach (var account in item.Accounts)
                            {
                                bool isResolved = item.ResolvedAccountId == account.Id.ToString();
                                
                                <FluentStack Orientation="Orientation.Horizontal" 
                                             HorizontalAlignment="HorizontalAlignment.SpaceBetween" 
                                             VerticalAlignment="VerticalAlignment.Center"
                                             Class="account-item">
                                    <FluentStack Orientation="Orientation.Vertical" VerticalGap="0">
                                        <FluentText Typo="Typography.Body">@account.Name</FluentText>
                                        <FluentText Typo="Typography.Caption" Color="Color.Default">@account.Balance.ToString("N4") @item.Asset</FluentText>
                                    </FluentStack>

                                    @if (isResolved)
                                    {
                                        <FluentBadge Id="@($"active-badge-{account.Id}")" Color="BadgeColor.Success">ACTIVE</FluentBadge>
                                    }
                                    else
                                    {
                                        <FluentButton Id="@($"pin-button-{account.Id}")" 
                                                      Appearance="ButtonAppearance.Subtle" 
                                                      IconEnd="@(new Icons.Regular.Size16.Pin())"
                                                      OnClick="@(() => PinAccountAsync(item.Asset, account.Id))">
                                            Pin
                                        </FluentButton>
                                    }
                                </FluentStack>
                            }
                        </FluentStack>
                    </FluentCard>
                </FluentGridItem>
            }
        </FluentGrid>
    }
</div>

