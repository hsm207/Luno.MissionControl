@page "/wallets"
@rendermode InteractiveAuto
@namespace Luno.MissionControl.Web.Client.Components.Wallets
@using Microsoft.FluentUI.AspNetCore.Components

<div class="wallets-container">
    <div class="wallets-header">
        <FluentStack VerticalAlignment="VerticalAlignment.Center">
            <FluentIcon Value="@(new Icons.Regular.Size32.Wallet())" Color="Color.Primary" />
            <FluentText As="TextTag.H2" Size="TextSize.Size700" Weight="TextWeight.Bold">
                Wallets Hub
            </FluentText>
        </FluentStack>
    </div>

    @if (_isLoading)
    {
        <FluentSpinner />
    }
    else if (_errorMessage != null)
    {
        <FluentMessageBar Title="Error" Intent="MessageBarIntent.Error">
            @_errorMessage
        </FluentMessageBar>
    }
    else if (_spotWallets is null || !HasAnyWallets)
    {
        <FluentMessageBar Title="No Wallets" Intent="MessageBarIntent.Info">
            No wallets available from Luno.
        </FluentMessageBar>
    }
    else
    {
        <FluentTabs Id="wallets-tabs">
            <FluentTab Header="Spot Trading Wallets" Id="tab-spot">
                @if (_spotWallets.Count == 0)
                {
                    <FluentMessageBar Title="No SPOT Wallets" Intent="MessageBarIntent.Info">
                        No SPOT trading wallets found.
                    </FluentMessageBar>
                }
                else
                {
                    <FluentGrid Spacing="3">
                        @foreach (var wallet in _spotWallets)
                        {
                            <SpotWalletCard @key="wallet.Asset"
                                            Wallet="wallet"
                                            OnPin="@(id => PinAccountAsync(wallet.Asset, id))"
                                            OnCopyId="CopyToClipboardAsync" />
                        }
                    </FluentGrid>
                }
            </FluentTab>
            <FluentTab Header="Transactional (View-Only)" Id="tab-transactional">
                <ViewOnlyWalletsGrid Cards="_transactionalCards"
                                     OnCopyId="CopyToClipboardAsync" />
            </FluentTab>
            <FluentTab Header="Staking & Other (View-Only)" Id="tab-staking">
                <ViewOnlyWalletsGrid Cards="_otherViewOnlyCards"
                                     OnCopyId="CopyToClipboardAsync" />
            </FluentTab>
        </FluentTabs>
    }
</div>
