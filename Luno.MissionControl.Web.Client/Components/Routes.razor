@using Luno.MissionControl.Web.Client.Components.Layout
@using Luno.MissionControl.Web.Client.Pages

<Router AppAssembly="@typeof(Routes).Assembly" AdditionalAssemblies="new[] { typeof(Luno.MissionControl.Web.Client._Imports).Assembly }">
    <Found Context="routeData">
        <RouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)" />
        <FocusOnNavigate RouteData="@routeData" Selector="h1" />
    </Found>
    <NotFound>
        <LayoutView Layout="@typeof(MainLayout)">
            <p role="alert">Sorry, there's nothing at this address.</p>
        </LayoutView>
    </NotFound>
</Router>
