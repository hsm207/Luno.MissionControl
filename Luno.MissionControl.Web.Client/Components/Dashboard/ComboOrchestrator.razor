@using Luno.MissionControl.Application
@using Luno.MissionControl.Application.Models
@using Luno.MissionControl.Web.Client.Services
@using System.Globalization

<ErrorBoundary @ref="_errorBoundary">
    <ChildContent>
<main>
    <FluentStack Orientation="Orientation.Vertical" 
                 HorizontalAlignment="HorizontalAlignment.Center" 
                 VerticalAlignment="VerticalAlignment.Top" 
                 VerticalGap="30" 
                 Class="basket-page-container">
        
        <div class="title-row">
            <h1 class="page-title">CUSTOM COIN COMBO</h1>
            <div class="allocation-summary">
                <div class="allocation-label">Model Allocation</div>
                <div class="allocation-value @(_totalWeight == 1.0m ? "emerald-glow" : "warning-glow")">@_totalWeight.ToString("P0")</div>
            </div>
        </div>

        <div class="investment-hero">
            <div class="sentence">
                <span class="sentence-text">I want to invest</span>
                <div class="editable-wrapper">
                    <FluentTextInput @ref="_amountInput"
                                     @bind-Value="_rawSpendInput"
                                     @bind-Value:after="@(async () => { if (decimal.TryParse(_rawSpendInput, NumberStyles.Any, CultureInfo.InvariantCulture, out var d)) { State.TargetSpend = d; _rawSpendInput = d.ToString("N0"); } })"
                                     Appearance="TextInputAppearance.FilledDarker"
                                     Class="hero-input" />
                </div>
                <div class="editable-wrapper">
                    <FluentSelect Items="@(new[] { "MYR", "USDC" })"
                                  @bind-Value="@_currencyState"
                                  Class="hero-select">
                        <span slot="indicator" class="hidden-indicator"></span>
                    </FluentSelect>
                </div>
                <span class="sentence-text">across this combo.</span>
            </div>
        </div>
        <FluentCard Class="gilded-card">
            <FluentDataGrid Items="@_allocations.AsQueryable()" TGridItem="Allocation" Class="basket-grid">
                <TemplateColumn Title="Asset Pair">
                    <span class="asset-name">@FormatPair(context.Pair)</span>
                </TemplateColumn>
                <TemplateColumn Title="Live Price">
                    <span class="asset-price"><PriceLabel Pair="@context.Pair" /></span>
                </TemplateColumn>
                <TemplateColumn Title="Weight (%)">
                    <div class="asset-weight">
                        <WeightInput Id="@($"weight-input-{context.Pair}")"
                                      Weight="@context.Weight" 
                                      HideLabel="true"
                                      WeightChanged="@(val => UpdateWeight(context.Pair, val))" />
                    </div>
                </TemplateColumn>

                <TemplateColumn Title="Planned Spend">
                    <span class="asset-spend">@GetCurrencySymbol() @GetAllocatedAmount(context).ToString("N2")</span>
                </TemplateColumn>
                <TemplateColumn Title="">
                    <button class="btn-delete" @onclick="@(() => RemoveAsset(context.Pair))">×</button>
                </TemplateColumn>
            </FluentDataGrid>

            <div class="strategy-footer-section">
                <h4 class="strategy-title">EXECUTION STRATEGY</h4>
                <p class="strategy-text">
                    Your orders will be placed as <span class="gold-text">LIMIT ORDERS</span> to bypass the Instant Buy spread. 
                    This ensures you get the absolute best price for your order.
                </p>
            </div>

            <div class="actions-footer">
                <div class="search-wrapper">
                    <FluentAutocomplete TOption="MarketMetadata"
                                        TValue="string"
                                        Placeholder="Search for a coin to add..."
                                        OnOptionsSearch="@OnSearchAsync"
                                        OptionText="@(m => $"{m.BaseCurrency} ({m.Pair})")"
                                        @bind-SelectedItems="@_selectedSearchItems"
                                        Multiple="false"
                                        Class="search-box" />
                    <FluentButton IconStart="@(new Icons.Regular.Size20.AddCircle())"
                                  OnClick="@AddAsset"
                                  Appearance="ButtonAppearance.Subtle"
                                  Class="add-coin-button"
                                  Title="Add to Combo" />
                </div>
                <div class="liquid-glow-wrapper">
                    <FluentButton Appearance="ButtonAppearance.Primary"
                                  Type="ButtonType.Button"
                                  Disabled="@(_totalWeight != 1.0m || _isExecuting)"
                                  OnClick="@ExecuteBasket"
                                  Class="buy-button">
                        @(_isExecuting ? "PLACING ORDERS..." : "BUY COIN COMBO")
                    </FluentButton>
                </div>
            </div>
        </FluentCard>

        <div class="data-freshness-footer">
            <div class="status-indicator-dot @(_lastPriceUpdate == null ? "connecting" : "online")"></div>
            <div class="status-value">@DataFreshnessText</div>
        </div>

    </FluentStack>
</main>


    </ChildContent>
    <ErrorContent>
        <div class="error-container">
            <FluentLabel Class="error-title">Something went wrong</FluentLabel>
            <p class="error-text">The basket interface has encountered an error. Please refresh the page.</p>
        </div>
    </ErrorContent>
</ErrorBoundary>
