@page "/basket"
@using Luno.MissionControl.Application
@using Luno.MissionControl.Application.Models
@using Luno.MissionControl.Web.Client.Services
@using System.Globalization

<ErrorBoundary @ref="_errorBoundary">
    <ChildContent>
        <FluentStack Class="basket-page-container">
            <FluentStack Class="header-main-stack">
                <FluentText Class="executive-header">CUSTOM COIN COMBO</FluentText>
                
                <FluentSpacer />

                <FluentStack Class="header-allocation-stack">
                    <FluentText>
                        Model Allocation: <span class="emerald-text allocation-percent">@_totalWeight.ToString("P0")</span>
                    </FluentText>
                    @if (_totalWeight != 1.0m)
                    {
                        <FluentBadge Class="remaining-badge">
                            @( (1.0m - _totalWeight).ToString("P0") ) Remaining
                        </FluentBadge>
                    }
                </FluentStack>
            </FluentStack>

            <FluentCard Class="gilded-card investment-card">
                    <div class="investment-sentence-wrapper">
                        <FluentIcon Value="@(new Icons.Filled.Size24.Money())" Class="investment-icon" />
                        
                        <FluentText Class="investment-label">I want to invest</FluentText>
                        
                        <FluentTextInput @bind-Value="_rawSpendInput"
                                         @bind-Value:after="@(async () => { if (decimal.TryParse(_rawSpendInput, NumberStyles.Any, CultureInfo.InvariantCulture, out var d)) { State.TargetSpend = d; _rawSpendInput = d.ToString("N0"); } })"
                                         Class="investment-amount-input" />

                        <FluentSelect Items="@(new[] { "MYR", "USDC" })"
                                      @bind-Value="@_currencyState"
                                      Class="currency-minimal-select">
                            <span slot="indicator" class="hidden-indicator"></span>
                        </FluentSelect>

                        <FluentText Class="investment-label">across this combo.</FluentText>
                    </div>

                    <div class="estimated-total-container">
                        <FluentText Class="estimated-total-label">
                            ESTIMATED TOTAL: <span class="estimated-total-value">@GetCurrencySymbol() @_calculatedTotal.ToString("N2")</span>
                            <span class="estimated-total-note">(Using limit orders to bypass Instant Buy spreads)</span>
                        </FluentText>
                    </div>

                    <FluentDivider Class="basket-divider" />

                    <FluentDataGrid Items="@_allocations.AsQueryable()" TGridItem="Allocation" Class="basket-grid">
                        <TemplateColumn Title="Asset Pair">
                            <FluentText Class="asset-pair-label">@FormatPair(context.Pair)</FluentText>
                        </TemplateColumn>
                        <TemplateColumn Title="Live Price" Class="price-column">
                            <PriceLabel Pair="@context.Pair" />
                        </TemplateColumn>
                        <TemplateColumn Title="Weight (%)" Class="weight-column">
                            <WeightInput Weight="@context.Weight" 
                                          HideLabel="true"
                                          WeightChanged="@(val => UpdateWeight(context.Pair, val))" />
                        </TemplateColumn>
                        <TemplateColumn Title="Planned Spend" Class="spend-column">
                            <FluentText>@GetCurrencySymbol() @GetAllocatedAmount(context).ToString("N2")</FluentText>
                        </TemplateColumn>
                        <TemplateColumn Title="" Class="delete-column">
                            <FluentButton IconEnd="@(new Icons.Regular.Size20.Delete())" 
                                          OnClick="@(() => RemoveAsset(context.Pair))"
                                          Title="Remove Asset" />
                        </TemplateColumn>
                    </FluentDataGrid>

                    <FluentDivider Class="basket-divider" />

                    <FluentStack Class="search-stack">
                        <div class="search-input-wrapper">
                            <FluentAutocomplete TOption="MarketMetadata"
                                                TValue="string"
                                                Label="Add a Coin"
                                                Placeholder="Search for a coin to add (e.g. XBT, SOL)..."
                                                OnOptionsSearch="@OnSearchAsync"
                                                OptionText="@(m => $"{m.BaseCurrency} ({m.Pair})")"
                                                @bind-SelectedItems="@_selectedSearchItems"
                                                Multiple="false"
                                                Class="asset-search" />
                        </div>
                        <FluentButton IconStart="@(new Icons.Regular.Size16.Add())"
                                       OnClick="@AddAsset"
                                       Class="add-button">
                            Add to Combo
                        </FluentButton>
                    </FluentStack>
            </FluentCard>

            <FluentStack Class="execution-container">
                <div class="liquid-glow-wrapper">
                    <FluentButton Class="btn-gilded execute-button"
                                  Disabled="@(_totalWeight != 1.0m || _isExecuting)"
                                  OnClick="@ExecuteBasket">
                        @(_isExecuting ? "PLACING ORDERS..." : "BUY COIN COMBO")
                    </FluentButton>
                </div>
            </FluentStack>
        </FluentStack>
    </ChildContent>
    <ErrorContent>
        <div class="error-container">
            <FluentLabel Class="error-title">Something went wrong</FluentLabel>
            <p class="error-text">The basket interface has encountered an error. Please refresh the page.</p>
        </div>
    </ErrorContent>
</ErrorBoundary>
