@page "/basket"
@using Luno.MissionControl.Application
@using Luno.MissionControl.Application.Models
@using Luno.MissionControl.Web.Client.Services
@using System.Globalization

<ErrorBoundary @ref="_errorBoundary">
    <ChildContent>
        <FluentStack Orientation="Orientation.Vertical" VerticalGap="24" Style="padding-bottom: 60px;">
            <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center">
                <FluentLabel Typo="Typography.Subject" Class="gold-text" Style="font-family: var(--header-font); letter-spacing: 3px; font-weight: 900;">CUSTOM COIN COMBO</FluentLabel>
                
                <FluentSpacer />

                <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="16" VerticalAlignment="VerticalAlignment.Center">
                    <FluentLabel Typo="Typography.Body">Model Allocation: <span class="emerald-text" style="font-size: 1.2rem;">@_totalWeight.ToString("P0")</span></FluentLabel>
                    @if (_totalWeight != 1.0m)
                    {
                        <FluentBadge Appearance="BadgeAppearance.Outline">
                            @( (1.0m - _totalWeight).ToString("P0") ) Remaining
                        </FluentBadge>
                    }
                </FluentStack>
            </FluentStack>

            <FluentCard Class="gilded-card" Style="padding: 30px; overflow: visible; contain: none;">
                    <div class="investment-sentence-wrapper" style="margin-bottom: 32px;">
                        <FluentIcon Value="@(new Icons.Filled.Size24.Money())" Color="Color.Primary" Style="align-self: center;" />
                        
                        <FluentLabel Typo="Typography.H3" Style="font-weight: 200; opacity: 0.8; letter-spacing: 1px;">I want to invest</FluentLabel>
                        
                        <FluentTextInput @bind-Value="_rawSpendInput"
                                         @bind-Value:after="@(async () => { if (decimal.TryParse(_rawSpendInput, NumberStyles.Any, CultureInfo.InvariantCulture, out var d)) { State.TargetSpend = d; _rawSpendInput = d.ToString("N0"); } })"
                                         TextInputType="TextInputType.Text"
                                         Class="investment-amount-input"
                                         Style="font-size: 1.8rem; font-weight: 800; color: var(--titan-gold) !important; width: 130px;" />

                        <FluentSelect Items="@(new[] { "MYR", "USDC" })"
                                      @bind-Value="@_currencyState"
                                      Class="currency-minimal-select"
                                      Appearance="ListAppearance.Transparent">
                            <span slot="indicator" style="display: none !important; width: 0; padding: 0;"></span>
                        </FluentSelect>

                        <FluentLabel Typo="Typography.H3" Style="font-weight: 200; opacity: 0.8; letter-spacing: 1px;">across this combo.</FluentLabel>
                    </div>

                    <div style="margin-top: -16px; margin-bottom: 24px; padding-left: 42px;">
                        <FluentLabel Typo="Typography.Body" Style="font-size: 0.85rem; opacity: 0.7;">
                            ESTIMATED TOTAL: <span class="gold-text" style="font-weight: 700;">@GetCurrencySymbol() @_calculatedTotal.ToString("N2")</span>
                            <span style="font-weight: 400; opacity: 0.5; margin-left: 8px;">(Using limit orders to bypass Instant Buy spreads)</span>
                        </FluentLabel>
                    </div>

                    <FluentDivider Style="margin: 20px 0;" />

                    <FluentDataGrid Items="@_allocations.AsQueryable()" TGridItem="Allocation" Style="min-height: 200px;">
                        <TemplateColumn Title="Asset Pair">
                            <FluentLabel Typo="Typography.Body" Style="font-weight: bold;">@FormatPair(context.Pair)</FluentLabel>
                        </TemplateColumn>
                        <TemplateColumn Title="Live Price" Align="DataGridCellAlignment.Center">
                            <PriceLabel Pair="@context.Pair" />
                        </TemplateColumn>
                        <TemplateColumn Title="Weight (%)" Align="DataGridCellAlignment.End">
                            <WeightInput Weight="@context.Weight" 
                                          HideLabel="true"
                                          WeightChanged="@(val => UpdateWeight(context.Pair, val))" />
                        </TemplateColumn>
                        <TemplateColumn Title="Planned Spend" Align="DataGridCellAlignment.End">
                            <FluentLabel Typo="Typography.Body" Style="font-family: monospace;">@GetCurrencySymbol() @GetAllocatedAmount(context).ToString("N2")</FluentLabel>
                        </TemplateColumn>
                        <TemplateColumn Title="" Align="DataGridCellAlignment.Center">
                            <FluentButton IconEnd="@(new Icons.Regular.Size20.Delete())" 
                                          OnClick="@(() => RemoveAsset(context.Pair))"
                                          Appearance="ButtonAppearance.Subtle"
                                          Title="Remove Asset" />
                        </TemplateColumn>
                    </FluentDataGrid>

                    <FluentDivider Style="margin: 20px 0;" />

                    <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="12" VerticalAlignment="VerticalAlignment.Bottom">
                        <div style="flex-grow: 1;">
                            <FluentAutocomplete TOption="MarketMetadata"
                                                TValue="string"
                                                Label="Add a Coin"
                                                Placeholder="Search for a coin to add (e.g. XBT, SOL)..."
                                                OnOptionsSearch="@OnSearchAsync"
                                                OptionText="@(m => $"{m.BaseCurrency} ({m.Pair})")"
                                                @bind-SelectedItems="@_selectedSearchItems"
                                                Multiple="false"
                                                Width="100%"
                                                InputAppearance="TextInputAppearance.Underline" />
                        </div>
                        <FluentButton IconStart="@(new Icons.Regular.Size16.Add())"
                                       OnClick="@AddAsset"
                                       Appearance="ButtonAppearance.Outline">
                            Add to Combo
                        </FluentButton>
                    </FluentStack>
            </FluentCard>

            <FluentStack Orientation="Orientation.Horizontal" HorizontalAlignment="HorizontalAlignment.Right" Style="margin-top: 30px;">
                <div class="liquid-glow-wrapper">
                    <FluentButton Class="btn-gilded"
                                  Appearance="ButtonAppearance.Primary"
                                  Disabled="@(_totalWeight != 1.0m || _isExecuting)"
                                  OnClick="@ExecuteBasket"
                                  Style="width: 320px; height: 56px;">
                        @(_isExecuting ? "PLACING ORDERS..." : "BUY COIN COMBO")
                    </FluentButton>
                </div>
            </FluentStack>
        </FluentStack>
    </ChildContent>
    <ErrorContent>
        <div style="padding: 20px; border: 1px solid red; border-radius: 8px; background: #fff0f0;">
            <FluentLabel Typo="Typography.Subject" Color="Color.Error">Something went wrong</FluentLabel>
            <p>The basket interface has encountered an error. Please refresh the page.</p>
        </div>
    </ErrorContent>
</ErrorBoundary>
