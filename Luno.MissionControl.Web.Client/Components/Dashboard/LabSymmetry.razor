@page "/lab-symmetry"
@using Microsoft.FluentUI.AspNetCore.Components

<div style="background-color: var(--obsidian-deep); padding: 50px; min-height: 100vh;">
    <div class="gilded-card" style="width: 400px; padding: 24px; margin: 0 auto;">
        <FluentLabel Typo="Typography.H3" Class="executive-header">REPRODUCING CLUSTERING</FluentLabel>
        
        <FluentDivider Style="margin: 10px 0;" />

        <p style="color: white; font-size: 0.8rem; margin-bottom: 12px;">
            Target: SpaceBetween justification using official V5 parameters.
        </p>

        <!-- Using the Official V5 Spacer Pattern -->
        <FluentStack Orientation="Orientation.Vertical" VerticalGap="16" Width="100%">
            
            <p style="color: grey; font-size: 0.7rem;">Official V5 Spacer Pattern (Red)</p>
            <FluentStack Orientation="Orientation.Horizontal" Width="100%" Style="border: 1px solid red; padding: 4px;">
                <FluentLabel Typo="Typography.Body">XBT / MYR</FluentLabel>
                <FluentSpacer />
                <FluentLabel Typo="Typography.Body" Class="gold-text">40%</FluentLabel>
            </FluentStack>

            <p style="color: grey; font-size: 0.7rem;">Multi-Spacer Pattern (Green)</p>
            <FluentStack Orientation="Orientation.Horizontal" Width="100%" Style="border: 1px solid green; padding: 4px;">
                <FluentLabel Typo="Typography.Body">LEFT</FluentLabel>
                <FluentSpacer />
                <FluentLabel Typo="Typography.Body">CENTER</FluentLabel>
                <FluentSpacer />
                <FluentLabel Typo="Typography.Body">RIGHT</FluentLabel>
            </FluentStack>

        </FluentStack>
    </div>
</div>

