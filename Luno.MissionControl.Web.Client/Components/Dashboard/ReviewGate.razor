@using Microsoft.FluentUI.AspNetCore.Components
@using Luno.MissionControl.Application.Commands
@using Luno.MissionControl.Application.Models
<FluentDialogBody>
    <TitleTemplate>
        <FluentStack VerticalAlignment="VerticalAlignment.Center" HorizontalGap="12">
            <FluentIcon Value="@(new Icons.Filled.Size24.ShieldError())" Color="Color.Primary" />
            <FluentLabel Typo="Typography.PaneHeader" Class="executive-header" Style="font-size: 1.25rem;">CONFIRM YOUR COMBO</FluentLabel>
        </FluentStack>
    </TitleTemplate>

    <ChildContent>
        <FluentStack Orientation="Orientation.Vertical" VerticalGap="24">
            <FluentLabel Typo="Typography.Body">
                You are about to buy a custom combo of&nbsp;<b>@Content.Allocations.Count coins</b>.
            </FluentLabel>

            <div class="gilded-card breathing-glow" style="padding: 24px; width: 100%; box-sizing: border-box;">
                <FluentStack Orientation="Orientation.Vertical" VerticalGap="16" Width="100%">
                    @foreach (var alloc in Content.Allocations)
                    {
                        <FluentStack Orientation="Orientation.Horizontal" Width="100%" VerticalAlignment="VerticalAlignment.Center">
                            <FluentLabel Typo="Typography.Body" Style="font-weight: 600; font-family: 'Outfit', sans-serif; letter-spacing: 0.5px;">
                                @FormatPair(alloc.Pair)
                            </FluentLabel>
                            <FluentSpacer />
                            <FluentLabel Typo="Typography.Body" Class="gold-text" Style="font-weight: 800; text-align: right;">
                                @(alloc.Weight.ToString("P0"))
                            </FluentLabel>
                        </FluentStack>
                    }
                </FluentStack>
            </div>

            <FluentDivider Style="margin: 8px 0;" />

            <FluentStack Orientation="Orientation.Horizontal" Width="100%" VerticalAlignment="VerticalAlignment.Center">
                <FluentLabel Typo="Typography.Body" Style="font-weight: 800; color: var(--titan-gold); letter-spacing: 1px;">TOTAL INVESTMENT</FluentLabel>
                <FluentSpacer />
                <FluentLabel Typo="Typography.H2" Class="gold-text" Style="font-weight: 900;">
                    RM&nbsp;@Content.TotalSpend.ToString("N2")
                </FluentLabel>
            </FluentStack>

            <FluentCheckbox @bind-Value="@_isConfirmed" Label="I acknowledge that this trade is final and cannot be undone." Style="margin-top: 10px;" />
        </FluentStack>
    </ChildContent>

    <ActionTemplate>
        <FluentStack Orientation="Orientation.Horizontal" 
                     HorizontalAlignment="HorizontalAlignment.Center" 
                     HorizontalGap="24" 
                     Width="100%" 
                     Style="margin-top: 24px; padding-bottom: 8px;">
            <FluentButton Appearance="ButtonAppearance.Subtle" 
                          OnClick="@CancelAsync" 
                          Style="min-width: 120px;">
                Cancel
            </FluentButton>
            <div class="liquid-glow-wrapper">
                <FluentButton Class="btn-gilded"
                              Appearance="ButtonAppearance.Primary"
                              Disabled="@(!_isConfirmed)" 
                              OnClick="@ConfirmAsync"
                              Style="min-width: 200px; height: 48px;">
                    CONFIRM PURCHASE
                </FluentButton>
            </div>
        </FluentStack>
    </ActionTemplate>
</FluentDialogBody>
