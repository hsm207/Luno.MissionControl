@using Microsoft.FluentUI.AspNetCore.Components

<FluentTextInput Value="@(WeightValue?.ToString())"
                 ValueChanged="@(val => { if (decimal.TryParse(val, out var d)) WeightValue = d; })"
                 TextInputType="TextInputType.Number"
                 Label="@(HideLabel ? null : "Weight (%)")"
                 Style="width: 100px;"
                 Class="right-align-text"
                 Appearance="TextInputAppearance.Outline"
                 Placeholder="0" />
