    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Luno.MissionControl.Application/Luno.MissionControl.Application.csproj" />
    <ProjectReference Include="../../Luno.SDK/Luno.SDK.Core/Luno.SDK.Core.csproj" />
    <ProjectReference Include="../../Luno.SDK/Luno.SDK.Infrastructure/Luno.SDK.Infrastructure.csproj" />
