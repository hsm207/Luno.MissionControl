<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <Format>cobertura</Format>
          <!-- Exclude the SDK projects from the Mission Control coverage results -->
          <!-- Syntax: [AssemblyFilter]TypeFilter -->
          <Exclude>[Luno.SDK*]*</Exclude>
          
          <!-- Explicitly include only Mission Control -->
          <Include>[Luno.MissionControl*]*</Include>
          
          <!-- Standard exclusions for system and test assemblies -->
          <ExcludeByAttribute>GeneratedCode</ExcludeByAttribute>
          <ExcludeByFile>**/Migrations/*,**/*.designer.cs</ExcludeByFile>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>

  <!-- Automation defaults to reduce CLI noise and ensure Aspire resource logs are visible without manual flags -->
  <RunConfiguration>
    <NoLogo>true</NoLogo>
  </RunConfiguration>

  <LoggerRunSettings>
    <Loggers>
      <Logger friendlyName="console" enabled="True">
        <Configuration>
          <Verbosity>normal</Verbosity>
        </Configuration>
      </Logger>
    </Loggers>
  </LoggerRunSettings>

  <!-- Enable headed mode and slow-mo for local UI debugging sessions -->
  <Playwright>
    <BrowserName>chromium</BrowserName>
    <LaunchOptions>
      <Headless>false</Headless>
      <SlowMo>500</SlowMo>
    </LaunchOptions>
  </Playwright>
</RunSettings>
